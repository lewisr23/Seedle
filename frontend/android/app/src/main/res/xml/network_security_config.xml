<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext is permitted only for the development machine on the local
        network, so a debug build can reach the API before the real host
        exists. Everything else, including the live site, must be HTTPS.
        Remove this block once the app points at seedle.uk.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.65</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
