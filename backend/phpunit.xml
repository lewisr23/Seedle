<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Port 1 is never bound, so the search service always takes its
             MySQL fallback path. Without this the suite quietly depends on
             nothing listening on 9200: start the Docker stack and the search
             tests would query the container's real index instead of their own
             fixtures, and fail.

             Note this only binds when the variable isn't already set in the
             real environment. Inside the app container docker-compose sets it
             (and DB_CONNECTION, QUEUE_CONNECTION...) for real, and a real env
             var reaches Laravel through $_SERVER, which PHPUnit never writes —
             so these values lose, force="true" included. See the README for
             the invocation that runs the suite inside a container safely. -->
        <env name="ELASTICSEARCH_HOST" value="http://127.0.0.1:1"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
